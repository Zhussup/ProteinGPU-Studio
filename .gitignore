.ruff_cache/

# ML weights & artifacts (large)
data/models/
data/jobs/

# ProteinGym raw benchmark (~43MB zip -> ~1GB CSVs; re-download via scripts/30).
# Fold-target fastas stay committed — they are the paper's objects.
data/proteingym/*
!data/proteingym/targets/

# DMS validation: only the curated manifest is committed (points at the
# gitignored substitution CSVs; scripts/34 builds it, scripts/30 fetches).
data/dms/*
!data/dms/curated.json

# Built binaries
*.so
*.o
*.cu.o
hpc_core/build/

# Frontend
node_modules/
dist/

# Reports (regenerable, but keep figures)
# data/report/ — commit figures, ignore raw json? keep all for now

